[{"s": 0.26, "e": 1.49, "text": "Fifty-six days until my"}, {"s": 1.49, "e": 2.7, "text": "first book comes out."}, {"s": 2.82, "e": 4.1, "text": "And honestly?"}, {"s": 4.22, "e": 4.95, "text": "I'm nervous."}, {"s": 4.99, "e": 6.44, "text": "I wrote it because I was"}, {"s": 6.44, "e": 7.15, "text": "the person"}, {"s": 7.17, "e": 8.45, "text": "with a notebook full of plans..."}, {"s": 8.53, "e": 10.15, "text": "and a life still on pause."}, {"s": 10.28, "e": 11.4, "text": "Too many ideas."}, {"s": 11.48, "e": 12.9, "text": "Overthinking every step."}, {"s": 12.97, "e": 14.75, "text": "Scared of picking the wrong one."}, {"s": 14.89, "e": 16.25, "text": "So I wrote the book I needed."}, {"s": 16.34, "e": 17.79, "text": "It's called The Life You"}, {"s": 17.79, "e": 18.7, "text": "Keep Planning."}, {"s": 18.77, "e": 20.5, "text": "If you're always about to start..."}, {"s": 20.55, "e": 21.85, "text": "this one's for you."}, {"s": 22.05, "e": 22.6, "text": "It's out on the"}, {"s": 22.6, "e": 24.0, "text": "twenty-third of January."}, {"s": 24.1, "e": 26.1, "text": "The Kindle pre-order is open now."}, {"s": 26.19, "e": 27.8, "text": "The link is in my bio."}]